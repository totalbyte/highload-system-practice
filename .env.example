# Скопіюйте у .env, щоб перевизначити значення за замовчуванням з docker-compose.yml.
# Без .env стек теж піднімається — усі змінні мають дефолти.

# Балансувальник HAProxy — єдина точка входу; backend-и портів назовні не мають.
LB_PORT=8080
LB_STATS_PORT=8404
POSTGRES_PORT=5433
REDIS_PORT=6379
ADMINER_PORT=8081
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@polling.dev
PGADMIN_PASSWORD=admin

POSTGRES_DB=polling
POSTGRES_USER=polling
POSTGRES_PASSWORD=polling

# Пул з'єднань одного інстансу: 30 для 1–3 інстансів; для 4+ — floor(90 / N), напр. 22 для чотирьох (ADR 0032).
DB_MAX_POOL_SIZE=30

# Щонайменше 32 символи (HMAC-SHA256).
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_LIFETIME_MINUTES=60

# Тестові дані: userNNN@example.com / Password123!
SEED_ENABLED=true
SEED_USERS=500
SEED_POLLS=50
