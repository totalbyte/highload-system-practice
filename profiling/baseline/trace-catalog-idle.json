    {
     "key": "db.query.text",
     "type": "string",
     "value": "SELECT p.id, p.title, p.status, p.is_public, p.creator_id, p.creator_username, (\n    SELECT count(*)::int\n    FROM options AS o\n    WHERE p.id = o.poll_id), p.starts_at, p.ends_at, p.created_at\nFROM polls AS p\nWHERE p.is_public AND p.status <> 'draft' AND p.status = @status\nORDER BY p.created_at DESC, p.id DESC\nLIMIT @p"
